<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootVBox" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700" prefWidth="1200" stylesheets="@../CSS/backgroundImage.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.Controllers.MenuController">
   <children>
      <StackPane maxHeight="63.0" minHeight="63.0" style="-fx-background-color: #2D2D2D; -fx-border-color: transparent transparent #767676 transparent; -fx-border-width: 2;">
         <children>
            <Label text="CINEMA" textFill="#8c1d18" StackPane.alignment="CENTER">
               <font>
                  <Font name="Arial Black" size="32.0" />
               </font>
            </Label>
         </children>
      </StackPane>
      <StackPane VBox.vgrow="ALWAYS">
         <children>
            <Button mnemonicParsing="false" onMouseClicked="#openHome" onMouseEntered="#menuEnter" onMouseExited="#menuExit" style="-fx-background-color: #2D2D2D; -fx-border-color: #767676; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="Αρχική" textFill="WHITE">
               <font>
                  <Font size="20.0" />
               </font></Button>
         </children>
      </StackPane>
      <StackPane VBox.vgrow="ALWAYS">
         <children>
            <Button mnemonicParsing="false" onMouseClicked="#openInfo" onMouseEntered="#menuEnter" onMouseExited="#menuExit" style="-fx-background-color: #2D2D2D; -fx-border-color: #767676; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="Οδηγίες" textFill="WHITE">
               <font>
                  <Font size="20.0" />
               </font></Button>
         </children>
      </StackPane>
      <StackPane VBox.vgrow="ALWAYS">
         <children>
            <Button mnemonicParsing="false" onMouseClicked="#openAbout" onMouseEntered="#menuEnter" onMouseExited="#menuExit" style="-fx-background-color: #2D2D2D; -fx-border-color: #767676; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="Πληροφορίες" textFill="WHITE">
               <font>
                  <Font size="20.0" />
               </font></Button>
         </children>
      </StackPane>
   </children>
</VBox>
