<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox minHeight="-Infinity" minWidth="-Infinity" prefHeight="700" prefWidth="1200" style="-fx-background-color: #191919;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controllers.AboutController">
    <children>
        <StackPane maxHeight="63.0" minHeight="63.0" style="-fx-background-color: #2D2D2D; -fx-border-color: transparent transparent #767676 transparent; -fx-border-width: 2;">
            <children>
                <Label text="CINEMA" textFill="#8c1d18" StackPane.alignment="CENTER">
                    <font>
                        <Font name="Arial Black" size="32.0" />
                    </font>
                </Label>
                <Label onMouseClicked="#openMenu" onMouseEntered="#hand" onMouseExited="#mouse" text="⬅" textFill="#8c1d18" StackPane.alignment="CENTER_LEFT">
                    <font>
                        <Font size="32.0" />
                    </font>
                    <StackPane.margin>
                        <Insets left="5.0" />
                    </StackPane.margin>
                </Label>
            </children>
        </StackPane>
        <VBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Γιατί δημιουργήθηκε:" textFill="#8c1d18">
                    <font>
                        <Font name="Arial Black" size="28.0" />
                    </font>
                </Label>
                <Label text="Αυτή η εφαρμογή δημιουργήθηκε τον χειμώνα του 2025-2026 ως μέρος του μαθήματος Αλληλεπίδραση Ανθρώπου-Μηχανής" textFill="WHITE" wrapText="true">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <Label text="Σχετικά με μένα:" textFill="#8c1d18">
                    <font>
                        <Font name="Arial Black" size="28.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="100.0" />
                    </VBox.margin>
                </Label>
                <Label text="Είμαι ο Κωνσταντίνος Βρούσγος, είμαι 20 χρονών, γεννήθηκα στη Θεσσαλονική και σπουδάζω στο τμήμα Μηχανικών Πληροφορικής και Ηλεκτρονικών Συστημάτων" textFill="WHITE" wrapText="true">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
            </children>
            <VBox.margin>
                <Insets left="30.0" top="30.0" />
            </VBox.margin>
        </VBox>
    </children>
</VBox>
